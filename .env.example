# Required for Dice login. Copy this file to .env and keep .env private.
DICE_USERNAME=
DICE_PASSWORD=

# Set true only if Dice has given you prior written authorization for automation.
DICE_AUTOMATION_AUTHORIZED=false

# Optional. Leave empty to let browser detection choose a supported Chromium browser.
WEB_BROWSER_PATH=
LIBREOFFICE_PATH=

# Required only for tailored resume mode.
OPENAI_API_KEY=

# Optional model override. The pinned default is available to this project's API account.
OPENAI_MODEL=gpt-5.5-2026-04-23
